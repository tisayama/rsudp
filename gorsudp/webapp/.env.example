# GoRSUDP WebApp Configuration Example
# Copy this file to .env.local and modify values as needed

# WebSocket connection settings
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8080/ws
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# For production deployment, update these URLs:
# NEXT_PUBLIC_WEBSOCKET_URL=wss://your-domain.com/ws
# NEXT_PUBLIC_API_BASE_URL=https://your-domain.com

# Chart configuration
NEXT_PUBLIC_DEFAULT_TIME_WINDOW=120
NEXT_PUBLIC_DEFAULT_FFT_SIZE=256
NEXT_PUBLIC_DEFAULT_SAMPLE_RATE=100

# Debug settings (set to false in production)
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=true